# ==========================================================================
# COSTA RICA UNIDOS — Variables de Entorno Seguras
# Módulo 05: Sistema de Información Geográfica (GIS) y Google Maps 3D
# ==========================================================================

# Clave de API de Google Maps JavaScript API (Con librerías Maps JavaScript API, Places y Geocoding habilitadas)
# Nota: Restrinja su clave en Google Cloud Console por HTTP Referrer para https://costaricaunidos.cr y localhost.
VITE_GOOGLE_MAPS_API_KEY=""

# Clave de API de Google Gemini (Único proveedor de IA: gemini-2.5-flash / gemini-2.5-pro)
VITE_GEMINI_API_KEY=""

# (Opcional) Modelo específico de Gemini (Por defecto: gemini-2.5-flash)
# VITE_GEMINI_MODEL="gemini-2.5-flash"

# ==========================================================================
# Módulo de Automatización n8n — Moderación Cívica y Blindaje Ley N.º 8968
# ==========================================================================
# URL del webhook de n8n para moderación complementaria del Foro (producción o test)
# Ejemplo local: "http://localhost:5678/webhook/foro-moderacion"
VITE_N8N_MODERACION_WEBHOOK_URL=""

# Secreto de autenticación enviado en el header 'x-webhook-secret' hacia n8n
VITE_N8N_WEBHOOK_SECRET=""
